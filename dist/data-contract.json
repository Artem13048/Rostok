{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Росток: обезличенный набор данных",
  "type": "object",
  "required": [
    "schemaVersion",
    "asOf",
    "products",
    "sales",
    "segments"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "farm": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "demo": {
      "type": "boolean"
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "unit",
          "price",
          "cost",
          "stock",
          "expiresIn",
          "leadDays",
          "photos",
          "completeness"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12
          },
          "price": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 10000000
          },
          "cost": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "stock": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "expiresIn": {
            "type": "number",
            "minimum": 0,
            "maximum": 3650
          },
          "leadDays": {
            "type": "number",
            "minimum": 0,
            "maximum": 365
          },
          "photos": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "completeness": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "sales": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "required": [
          "productId",
          "date",
          "units",
          "views",
          "revenue"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "units": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "views": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          },
          "revenue": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000000
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "count",
          "consented",
          "avgCheck",
          "marginRate",
          "lastOrderDays"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "count": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "consented": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "avgCheck": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "marginRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "lastOrderDays": {
            "type": "number",
            "minimum": 0,
            "maximum": 3650
          }
        }
      }
    }
  },
  "description": "Дополнительно в коде: asOf/продажи не в будущем, календарные даты, уникальность ID и пары товар-дата, ссылки на товары, consented <= count. Лишние поля игнорируются. Имена и контакты покупателей не передаются."
}